   "outputs": [],
   "source": [
    "d = {}\n",
    "n = int(input())\n",
    "for i in range(n):\n",
    "    word = input()\n",
    "    w2 = word.lower()\n",
    "    if w2 in d:\n",
    "        d[w2].append(word)\n",
    "    else:\n",
    "        d[w2] = [word]\n",
    "\n",
    "c = 0\n",
    "for i in input().split():\n",
    "    if i.lower() in d & i not in d[i.lower()]:\n",
    "        c += 1\n",
    "print(c)\n",
    "\n"
   ]
  }
 ],
